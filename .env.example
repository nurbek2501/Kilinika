# ── Backend ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dental
NODE_ENV=development
PORT=3001

# Auth — use long random strings in production
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seeded accounts (phone = login username). Use your OWN values — required in production.
DIRECTOR_NAME=Director Name
DIRECTOR_PHONE=director-login
DIRECTOR_PASSWORD=change-me
DOCTOR1_NAME=Doctor Name
DOCTOR1_PHONE=doctor-login
DOCTOR1_PASSWORD=change-me
ADMIN_NAME=Administrator
ADMIN_PHONE=admin-login
ADMIN_PASSWORD=change-me

# Eskiz SMS (optional)
ESKIZ_EMAIL=your-eskiz-email
ESKIZ_PASSWORD=your-eskiz-password

CORS_ORIGIN=http://localhost:3000

# ── Telegram Bot (runs inside the backend) ──
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:3001/api
